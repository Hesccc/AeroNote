# Flask 应用与安全配置
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=your-secure-random-secret-key-change-it-in-production

# CORS 允许的来源（逗号分隔），生产环境建议配置为具体前端域名
# CORS_ORIGINS=http://localhost:5173,https://your-blog-domain.com
CORS_ORIGINS=*

# 数据库类型与连接配置 (支持 MySQL, MariaDB, PostgreSQL)
# 模式一：通用参数配置（推荐）
# 只需要设置 DB_TYPE 即可自动切换底层方言与默认端口/用户:
# - MySQL:      DB_TYPE=MySQL      (默认端口 3306, 默认用户 root)
# - MariaDB:    DB_TYPE=MariaDB    (默认端口 3306, 默认用户 root)
# - PostgreSQL: DB_TYPE=PostgreSQL (默认端口 5432, 默认用户 postgres)
DB_TYPE=MySQL
DB_HOST=127.0.0.1
DB_PORT=3306           # 若留空，MySQL/MariaDB 默认 3306, PostgreSQL 默认 5432
DB_ROOT_PASSWORD=your_root_password
DB_USER=root           # 若留空，MySQL/MariaDB 默认为 root, PostgreSQL 默认为 postgres
DB_PASSWORD=your_password
DB_NAME=blog

# 模式二：直接指定标准 SQLAlchemy DATABASE_URL (若配置则最高优先级生效)
# MySQL 示例:
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/blog?charset=utf8mb4
# MariaDB 示例:
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/blog?charset=utf8mb4
# PostgreSQL 示例:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@127.0.0.1:5432/blog

# Docker 部署端口映射配置 (可选)
# FRONTEND_PORT=80

# 文件上传配置
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 最大上传大小（字节），此处为 16MB

# 大模型 (LLM) OpenAI 兼容接口配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 后台运行日志配置
# 日志级别可选: DEBUG | INFO | WARNING | ERROR
# 日志输出目录: ./logs/ (当天的日志名称为 日志分类.log，历史日志归档压缩为 日志分类_YYYYMMDD.log.tgz)
LOG_LEVEL=INFO
