# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs / Editors ---
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Python Backend (.venv & caches) ---
*/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.python-version
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
api/__pycache__
__pycache__
apps/__pycache__
# --- Local Databases ---
*.db
*.sqlite
*.sqlite3
data/

# --- Logs / Runtime Artifacts ---
*.log
*.log.tgz
logs/
apps/logs/
temp/
uploads/

# --- Node.js / Vite Frontend (under /frontend) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*
frontend/*.tsbuildinfo

# --- Environment Configuration Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
